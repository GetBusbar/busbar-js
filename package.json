{
  "name": "@busbar/busbar-admin",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Busbar admin API (generated from the typed OpenAPI 3.1 schema).",
  "license": "Apache-2.0",
  "author": "Busbar, Inc.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openapi.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/finalize-package.mjs",
    "prepack": "npm run build && npm run test:package",
    "test:package": "node --test tests/package-smoke.mjs"
  },
  "dependencies": {
    "@hey-api/client-fetch": "0.13.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "7.0.2"
  }
}
